{
  "name": "gestion-eventos",
  "version": "1.0.0",
  "description": "Aplicación de gestión de eventos - arquitectura hexagonal (dominio, aplicación, infraestructura)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev:front": "npm --prefix frontend run dev",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/*.test.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ]
      }
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.11.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.2.0",
    "mongodb": "^7.6.0",
    "mongoose": "^8.5.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
